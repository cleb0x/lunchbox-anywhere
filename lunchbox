#!/usr/bin/env bash
# Starts Lunchbox with your own command line agents (Claude Code and others) on this computer,
# usually a free Google Cloud Shell, and gives you the link to open it in the browser.
#   ./lunchbox            start (installs what is missing the first time)
#   ./lunchbox --update   fetch the newest Lunchbox first, even if one is already here
#   ./lunchbox --no-autostart   stop starting Lunchbox by itself when Cloud Shell opens
#   ./lunchbox --at-login       on your own computer: start Lunchbox whenever you log in
#   ./lunchbox --not-at-login   undo that
set -euo pipefail

REPO="${LUNCHBOX_REPO:-cleb0x/lunchbox-anywhere}"
APP="$HOME/.lunchbox-app"
PORT="${PORT:-8080}"
export PATH="$HOME/.local/bin:$PATH"

VERSION="8"
bold() { printf '\n\033[1m%s\033[0m\n' "$1"; }
fail() { printf '\n\033[31m%s\033[0m\n' "$1"; exit 1; }

# In Cloud Shell, a guide opens next to the terminal and says what to do at each moment.
GUIDE_DIR="$HOME/.lunchbox-app-guide"
guide() {
  [ -n "${WEB_HOST:-}${CLOUD_SHELL:-}" ] && command -v cloudshell >/dev/null 2>&1 || return 0
  mkdir -p "$GUIDE_DIR"
  printf '%s\n' "$2" > "$GUIDE_DIR/$1.md"
  (cd "$GUIDE_DIR" && cloudshell launch-tutorial "$1.md" >/dev/null 2>&1) || true
}

echo "Lunchbox launcher $VERSION"

# The launcher keeps itself up to date: the newest one from GitHub runs instead when it differs.
# (A folder opened with "Open in Cloud Shell" does not pull from GitHub by itself.)
if [ -z "${LUNCHBOX_NO_SELF_UPDATE:-}" ]; then
  latest="$(curl -fsSL "https://raw.githubusercontent.com/$REPO/main/lunchbox" 2>/dev/null || true)"
  if [ -n "$latest" ] && printf '%s' "$latest" | head -n1 | grep -q '^#!/usr/bin/env bash' && [ "$latest" != "$(cat "$0" 2>/dev/null)" ]; then
    echo "Updating the launcher…"
    if [ -w "$0" ]; then printf '%s\n' "$latest" > "$0"; chmod +x "$0"; fi
    exec env LUNCHBOX_NO_SELF_UPDATE=1 bash -c "$latest" lunchbox "$@"
  fi
fi

# In Cloud Shell, Lunchbox starts by itself whenever a terminal opens, unless it already runs.
MARK="# >>> lunchbox autostart >>>"
if [ "${1:-}" = "--no-autostart" ]; then
  [ -f "$HOME/.bashrc" ] && sed -i '/# >>> lunchbox autostart >>>/,/# <<< lunchbox autostart <<</d' "$HOME/.bashrc"
  echo "Lunchbox no longer starts by itself. Run it with: bash <(curl -fsSL https://raw.githubusercontent.com/$REPO/main/lunchbox)"
  exit 0
fi
# On your own computer: start at login, in the background, logging to ~/.config/Lunchbox/server.log.
RUN="bash <(curl -fsSL https://raw.githubusercontent.com/$REPO/main/lunchbox)"
if [ "${1:-}" = "--at-login" ] || [ "${1:-}" = "--not-at-login" ]; then
  mkdir -p "$HOME/.config/Lunchbox"
  if [ "$(uname -s)" = "Darwin" ]; then
    plist="$HOME/Library/LaunchAgents/dev.lunchbox.server.plist"
    if [ "$1" = "--at-login" ]; then
      mkdir -p "$(dirname "$plist")"
      cat > "$plist" <<PL
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>dev.lunchbox.server</string>
<key>ProgramArguments</key><array><string>/bin/bash</string><string>-lc</string><string>$RUN</string></array>
<key>RunAtLoad</key><true/><key>KeepAlive</key><true/>
<key>StandardOutPath</key><string>$HOME/.config/Lunchbox/server.log</string>
<key>StandardErrorPath</key><string>$HOME/.config/Lunchbox/server.log</string>
</dict></plist>
PL
      launchctl unload "$plist" 2>/dev/null || true
      launchctl load "$plist"
      echo "Lunchbox now starts when you log in to this Mac, and is starting now."
    else
      launchctl unload "$plist" 2>/dev/null || true; rm -f "$plist"; echo "Lunchbox no longer starts at login."
    fi
  else
    unit="$HOME/.config/systemd/user/lunchbox.service"
    if [ "$1" = "--at-login" ]; then
      mkdir -p "$(dirname "$unit")"
      printf '[Unit]\nDescription=Lunchbox\nAfter=network-online.target\n\n[Service]\nExecStart=/bin/bash -lc "%s"\nRestart=on-failure\nRestartSec=10\n\n[Install]\nWantedBy=default.target\n' "$RUN" > "$unit"
      systemctl --user daemon-reload && systemctl --user enable --now lunchbox.service
      echo "Lunchbox now starts when you log in, and is starting now. Its output: journalctl --user -u lunchbox"
    else
      systemctl --user disable --now lunchbox.service 2>/dev/null || true; rm -f "$unit"; echo "Lunchbox no longer starts at login."
    fi
  fi
  echo "The link to open on another device once is in ~/.config/Lunchbox/pair-link.txt after it has started."
  exit 0
fi

if { [ -n "${WEB_HOST:-}" ] || [ -n "${CLOUD_SHELL:-}" ]; } && [ -z "${LUNCHBOX_NO_AUTOSTART:-}" ] && ! grep -qF "$MARK" "$HOME/.bashrc" 2>/dev/null; then
  cat >> "$HOME/.bashrc" <<RC

$MARK
# Starts Lunchbox when Cloud Shell opens. To stop that, run the launcher with --no-autostart.
if [[ \$- == *i* ]] && [ -z "\${LUNCHBOX_AUTOSTARTED:-}" ] && ! pgrep -f "lunchbox-app/main.cjs" >/dev/null 2>&1; then
  export LUNCHBOX_AUTOSTARTED=1
  bash <(curl -fsSL https://raw.githubusercontent.com/$REPO/main/lunchbox)
fi
# <<< lunchbox autostart <<<
RC
  echo "From now on Lunchbox starts by itself when you open Cloud Shell."
fi

# Node 20 or newer. Cloud Shell has it.
if ! command -v node >/dev/null || [ "$(node -p 'process.versions.node.split(".")[0]')" -lt 20 ]; then
  fail "Lunchbox needs Node.js 20 or newer. Install it from https://nodejs.org and run ./lunchbox again."
fi

guide starting "# Lunchbox

## Starting Lunchbox

Lunchbox is starting in the terminal below. This takes about half a minute.

You don't need to type anything. This guide shows a button as soon as it's ready."

# Lunchbox itself: a small ready-made build, fetched from the project's releases.
if [ ! -f "$APP/main.cjs" ] || [ "${1:-}" = "--update" ] || [ -z "$(find "$APP/main.cjs" -mtime -1 2>/dev/null)" ]; then
  bold "Getting Lunchbox…"
  tmp="$(mktemp -d)"
  if curl -fsSL "https://github.com/$REPO/releases/download/server-latest/lunchbox-server.tar.gz" -o "$tmp/app.tgz"; then
    rm -rf "$APP.new" && mkdir -p "$APP.new" && tar -xzf "$tmp/app.tgz" -C "$APP.new"
    # The tunnel program is kept in the same folder; a new build must not throw it away.
    [ -x "$APP/cloudflared" ] && [ ! -e "$APP.new/cloudflared" ] && mv "$APP/cloudflared" "$APP.new/cloudflared"
    rm -rf "$APP" && mv "$APP.new" "$APP"
  elif [ ! -f "$APP/main.cjs" ]; then
    fail "Could not download Lunchbox. Check the connection and try again."
  else
    echo "Could not check for a newer Lunchbox; starting the one already here."
  fi
  rm -rf "$tmp"
fi

# Claude Code, installed with Anthropic's own installer.
if ! command -v claude >/dev/null; then
  bold "Installing Claude Code…"
  curl -fsSL https://claude.ai/install.sh | bash
  export PATH="$HOME/.local/bin:$PATH"
fi

# Signing in to Claude, once. The login stays in this computer's home folder.
if [ ! -s "$HOME/.claude/.credentials.json" ] && [ -z "${CLAUDE_CODE_OAUTH_TOKEN:-}" ] && [ -z "${ANTHROPIC_API_KEY:-}" ]; then
  guide signin "# Lunchbox

## Sign in to Claude (only once)

Claude Code opens in the terminal below.

1. Press **Enter** in the terminal to start.
2. Choose **Claude account with subscription**.
3. Open the link it shows, sign in with your Claude account, and copy the code.
4. Paste the code into the terminal and press **Enter**.
5. When it says you're logged in, type **/exit** and press **Enter**.

Lunchbox then starts by itself, and this guide shows the next step."
  bold "Sign in to Claude"
  cat <<'TXT'
Claude Code opens now. Choose "Claude account with subscription", open the link it shows,
sign in, and paste the code back here. When it says you are logged in, type /exit and press
Enter, and Lunchbox starts.
TXT
  read -r -p "Press Enter to continue… " _
  claude || true
  [ -s "$HOME/.claude/.credentials.json" ] || echo "Not signed in yet. Lunchbox starts anyway; run ./lunchbox again to sign in."
fi

# Codex, Gemini CLI and the others are picked up too when you install them yourself.

# A secret key for this computer, kept between runs. Links without it cannot reach Lunchbox.
KEYFILE="$HOME/.config/Lunchbox/server-key"
mkdir -p "$(dirname "$KEYFILE")"
[ -s "$KEYFILE" ] || (umask 077; head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n' > "$KEYFILE")
KEY="$(cat "$KEYFILE")"

# The desktop app keeps its rooms in the same place; two at once would write over each other.
# (Matched by where the app lives, not by name: this launcher is called lunchbox too.)
if [ -z "${WEB_HOST:-}${CLOUD_SHELL:-}" ] && pgrep -f 'Lunchbox\.app/Contents/MacOS/Lunchbox|/tmp/\.mount_Lunch|/opt/Lunchbox/lunchbox' >/dev/null 2>&1; then
  bold "The Lunchbox desktop app is open. Quit it first: both use the same rooms and would get in each other's way."
  exit 1
fi

# A free Cloudflare quick tunnel, so the Lunchbox website can reach this computer. No account.
TUNNEL=""
CF=""
if [ "${LUNCHBOX_TUNNEL:-1}" = "1" ]; then
  if command -v cloudflared >/dev/null; then CF="$(command -v cloudflared)"
  else
    CF="$APP/cloudflared"
    if [ ! -x "$CF" ]; then
      case "$(uname -m)" in x86_64|amd64) arch=amd64 ;; aarch64|arm64) arch=arm64 ;; *) arch="" ;; esac
      base="https://github.com/cloudflare/cloudflared/releases/latest/download"
      bold "Getting the tunnel (cloudflared)…"
      if [ "$(uname -s)" = "Linux" ] && [ -n "$arch" ]; then
        curl -fsSL "$base/cloudflared-linux-$arch" -o "$CF.part" && chmod +x "$CF.part" && mv "$CF.part" "$CF" || echo "Could not download cloudflared."
      elif [ "$(uname -s)" = "Darwin" ] && [ -n "$arch" ]; then
        curl -fsSL "$base/cloudflared-darwin-$arch.tgz" | tar -xzf - -C "$APP" && chmod +x "$CF" || echo "Could not download cloudflared."
      fi
    fi
  fi
fi

SITE="${LUNCHBOX_SITE:-https://${REPO%%/*}.github.io/${REPO#*/}/}"
host="127.0.0.1"; [ -n "${WEB_HOST:-}" ] && host="0.0.0.0"
LOG="$(mktemp)"
cleanup() { [ -n "${TPID:-}" ] && kill "$TPID" 2>/dev/null; [ -n "${SPID:-}" ] && kill "$SPID" 2>/dev/null; rm -f "$LOG"; }
trap cleanup EXIT INT TERM

# The tunnel first, so Lunchbox knows its address and can tell the website where it is.
if [ -n "$CF" ] && [ -x "$CF" ]; then
  echo "Opening the tunnel…"
  "$CF" tunnel --no-autoupdate --url "http://127.0.0.1:$PORT" >"$LOG" 2>&1 &
  TPID=$!
  for _ in $(seq 1 120); do
    TUNNEL="$(grep -o 'https://[a-z0-9-]*\.trycloudflare\.com' "$LOG" | head -n1 || true)"
    [ -n "$TUNNEL" ] && break
    sleep 0.5
  done
fi

# In Cloud Shell it stops after 20 minutes without an open page, so the shell can sleep.
idle="${LUNCHBOX_IDLE_MINUTES:-}"; [ -z "$idle" ] && [ -n "${WEB_HOST:-}${CLOUD_SHELL:-}" ] && idle=20
env PORT="$PORT" LUNCHBOX_HOST="${LUNCHBOX_HOST:-$host}" LUNCHBOX_KEY="$KEY" LUNCHBOX_QUIET=1 LUNCHBOX_IDLE_MINUTES="${idle:-0}" \
  LUNCHBOX_PUBLIC_URL="${TUNNEL:+$TUNNEL/}" node "$APP/main.cjs" &
SPID=$!

if [ -n "$TUNNEL" ]; then
  # A new tunnel takes a few seconds to answer; the link is shown once it does.
  echo "Waiting for the tunnel to answer…"
  for _ in $(seq 1 60); do
    curl -fsS -m 4 "$TUNNEL/health?key=$KEY" >/dev/null 2>&1 && break
    sleep 1
  done
  LINK="$SITE#connect=$TUNNEL&key=$KEY"
  PAIR="$SITE#pair=$KEY"
  printf '%s\n' "$PAIR" > "$HOME/.config/Lunchbox/pair-link.txt"
  guide ready "# Lunchbox

## Lunchbox is ready

**[Open Lunchbox]($LINK)**

Or, if you started here from the Lunchbox website, go back to that tab and reload it. It
connects by itself.

Keep this Cloud Shell tab open while you use Lunchbox. You can minimize it.

## When you're done

Just close the Lunchbox tab. Lunchbox stops by itself after 20 minutes, so Cloud Shell can sleep
and doesn't use up your free hours (about 50 a week).

## Next time

Open the Lunchbox website. If it says Lunchbox isn't running, click **Start in Cloud Shell**.
Lunchbox starts here by itself and this guide opens again."
  bold "Lunchbox is ready. Open this link:"
  printf '\n    \033[4m%s\033[0m\n\n' "$LINK"
  echo "(Ctrl+click it, or copy it into a new tab.)"
  echo
  echo "Once you have opened a link like this on a device, that device finds this Lunchbox by itself:"
  echo "just go to $SITE"
  [ -z "${WEB_HOST:-}${CLOUD_SHELL:-}" ] && echo "To use it from your Chromebook, open the link above there once (send it to yourself)."
  echo "Keep these links to yourself: they open your Lunchbox."
else
  if [ -n "$CF" ] && [ -x "$CF" ]; then
    echo "The tunnel did not start. What cloudflared said:"
    tail -n 15 "$LOG" | sed 's/^/    /'
  elif [ "${LUNCHBOX_TUNNEL:-1}" = "1" ]; then
    echo "The tunnel is not available (cloudflared could not be downloaded)."
  fi
  guide nolink "# Lunchbox

## The connection didn't start

Lunchbox is running, but the link to the website could not be made this time.

Open it with **Web Preview** instead: click <walkthrough-web-preview-icon></walkthrough-web-preview-icon>
at the top of Cloud Shell, then **Preview on port $PORT**. Then add **#key=$KEY** to the end of the
address of the page that opens, and press Enter.

Or press **Ctrl+C** in the terminal and run the launcher again to try once more."
  if [ -n "${WEB_HOST:-}" ]; then
    bold "Lunchbox is ready. Open it with Web Preview (the eye icon above), port $PORT:"
    printf '\n    \033[4mhttps://%s-%s/#key=%s\033[0m\n\n' "$PORT" "$WEB_HOST" "$KEY"
  else
    bold "Lunchbox is ready on this computer. Open it here:"
    printf '\n    \033[4mhttp://localhost:%s/#key=%s\033[0m\n\n' "$PORT" "$KEY"
  fi
fi
echo "Keep this window open while you use Lunchbox. Press Ctrl+C to stop it."
wait "$SPID"
